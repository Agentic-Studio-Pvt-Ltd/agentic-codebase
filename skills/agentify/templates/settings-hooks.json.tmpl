```json
{
  "_agentify": {
    "agentify-id": "{{AGENTIFY_ID}}",
    "agentify-version": 1,
    "agentify-generated": "{{GENERATED_DATE}}",
    "agentify-evidence": "{{EVIDENCE_LINE}}",
    "note": "Inert metadata describing this fragment. Do not merge this key into settings.json. Safe to delete or edit. No attribution line here, deliberately: this key is the one _agentify block that is never merged into a generated file, so a placement here would reach nothing. settings.json gets no attribution at all.",
    "merge_into": ".claude/settings.json",
    "idempotency_key": "hooks.{{HOOK_EVENT}}[].hooks[].command ends with /.claude/hooks/{{HOOK_FILE_NAME}}"
  },
  "hooks": {
    "{{HOOK_EVENT}}": [
      {
        "matcher": "{{HOOK_MATCHER}}",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/{{HOOK_FILE_NAME}}",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
```
