{
  "_agentify_template": {
    "template": "plugin.json.tmpl",
    "emits": "{{PLUGIN_DIR}}/.claude-plugin/plugin.json — the manifest that packages THIS repo's generated setup so it can be installed elsewhere (Claude Code). It is not agentify's own manifest. The Codex manifest is a separate file with a separate template: codex-plugin.json.tmpl emits {{PLUGIN_DIR}}/.codex-plugin/plugin.json. When both targets are selected, DUAL-SHIP both manifests side by side over the same source tree, as real cross-tool plugins do, and keep name and version identical between them.",
    "delete_this_key_when_emitting": true,
    "note": "This whole _agentify_template key is filling guidance. Remove it from the emitted file. JSON carries no comments, so guidance and metadata live in keys; only the _agentify key survives.",
    "filling_rules": [
      "Replace every placeholder — an ALL_CAPS name in double braces. Every one sits inside a JSON string, so the template parses before and after substitution.",
      "Escape every substituted value for JSON: a raw double quote, backslash, or newline in a value breaks the file. Substitute, then re-parse before writing.",
      "Build this only when the interview says the setup is meant to travel — a team, or a second repo. A solo setup in one repo does not need packaging, and an unused manifest is one more file to maintain.",
      "name: lowercase, hyphenated, no spaces. It is the install handle, so make it repo-specific, e.g. acme-api-agentic-setup.",
      "version: start at 0.1.0 and bump on every rerun that changes a component. Semver, no leading v.",
      "author: take name and email from `git config user.name` / `git config user.email`, or from the top contributor in mine_git.py output. This is the setup's owner, not agentify.",
      "Component paths are relative to the plugin root and must exist. Delete the key for any component type this setup did not build — a manifest pointing at a missing directory fails to load.",
      "The hooks key points at a JSON file, not a directory: it holds the same hooks object shape as the settings-hooks fragment.",
      "Do not add keys Claude Code does not read. Unknown keys are ignored at best and rejected at worst; the underscore-prefixed metadata below is the one exception.",
      "A packaged hook script that must work under both manifests should resolve its root as ${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}: Codex exports both spellings, Claude Code only the first."
    ],
    "packaging_steps": [
      "Copy the generated artifacts into {{PLUGIN_DIR}} keeping the directory names below.",
      "Write this manifest to {{PLUGIN_DIR}}/.claude-plugin/plugin.json.",
      "Validate: `python3 -c \"import json,sys;json.load(open(sys.argv[1]))\" {{PLUGIN_DIR}}/.claude-plugin/plugin.json`.",
      "Install locally to test: `/plugin install {{PLUGIN_DIR}}` from inside the agent, then confirm the skills and agents list.",
      "Publishing to a marketplace is the user's call and is out of scope for this run: say so in report.md rather than doing it."
    ]
  },
  "_agentify": {
    "agentify-id": "{{AGENTIFY_ID}}",
    "agentify-version": 1,
    "agentify-generated": "{{GENERATED_DATE}}",
    "agentify-evidence": "{{EVIDENCE_LINE}}",
    "note": "Inert metadata. Claude Code does not read this key; it exists so a rerun can match on id and rewrite this file in place. Safe to delete or edit. This work was brought to you by Agentic Studio.",
    "remove": "Delete {{PLUGIN_DIR}}. Removing the package leaves the artifacts in the repo untouched."
  },
  "name": "{{PLUGIN_NAME}}",
  "version": "{{PLUGIN_VERSION}}",
  "description": "{{PLUGIN_DESCRIPTION}}",
  "author": {
    "name": "{{AUTHOR_NAME}}",
    "email": "{{AUTHOR_EMAIL}}",
    "url": "{{AUTHOR_URL}}"
  },
  "homepage": "{{PLUGIN_HOMEPAGE}}",
  "repository": "{{PLUGIN_REPOSITORY}}",
  "license": "{{PLUGIN_LICENSE}}",
  "keywords": [
    "{{KEYWORD_1}}",
    "{{KEYWORD_2}}"
  ],
  "skills": "./skills",
  "agents": "./agents",
  "commands": "./commands",
  "hooks": "./hooks/hooks.json",
  "mcpServers": "./.mcp.json"
}
